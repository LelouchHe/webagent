{
  "name": "@lelouchhe/webagent",
  "version": "0.13.0",
  "description": "A terminal-style web UI for ACP-compatible agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LelouchHe/webagent.git"
  },
  "homepage": "https://github.com/LelouchHe/webagent#readme",
  "keywords": [
    "acp",
    "agent",
    "web-ui",
    "copilot",
    "chat",
    "sse"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "webagent": "bin/webagent.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "dist/",
    "config.toml"
  ],
  "scripts": {
    "compile": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "create-token": "node --experimental-strip-types scripts/create-token.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run compile && npm run build",
    "build": "node scripts/build.js",
    "start": "node --experimental-strip-types src/server.ts --config config.toml",
    "pretest": "test -f .husky/_/pre-push || npx husky",
    "test": "npm run compile && node --experimental-strip-types --test test/*.test.ts",
    "test:e2e": "node --experimental-strip-types test/e2e/run-suite.ts",
    "test:e2e:heartbeat": "node --experimental-strip-types test/e2e/determinism-check.ts heartbeat",
    "test:e2e:concurrent": "node --experimental-strip-types test/e2e/determinism-check.ts concurrent",
    "dev": "node scripts/build.js --watch & node --experimental-strip-types --watch src/server.ts --config config.dev.toml",
    "dev:start": "node scripts/build.js --dev && node --experimental-strip-types src/server.ts --config config.dev.toml &",
    "dev:stop": "lsof -ti:6801 | xargs kill 2>/dev/null || true",
    "screenshots": "playwright test --config scripts/screenshots.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/web-push": "^3.6.4",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "diff": "^9.0.0",
    "dompurify": "3.4.17",
    "file-type": "^22.0.1",
    "highlight.js": "^11.11.1",
    "image-size": "^2.0.4",
    "marked": "^18.0.2",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.6.0",
    "temml": "^0.14.0",
    "web-push": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.65.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true
  }
}
